{
  "name": "screenharbour-brasil",
  "version": "1.5",
  "private": true,
  "description": "Interface cinematográfica para Jellyfin (Edição Brasil), com fileiras personalizadas, integração TMDB dinâmica e navegação in-player",
  "author": "Shillooh",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shillooh/HabourBRVer.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.5",
    "esbuild": "0.25.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "mpegts.js": "^1.8.2"
  }
}
