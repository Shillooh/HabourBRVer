<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">10.11.0</JellyfinVersion>
    <TargetFramework Condition="'$(JellyfinVersion)' == '10.10.7'">net8.0</TargetFramework>
    <TargetFramework Condition="$([System.String]::Copy('$(JellyfinVersion)').StartsWith('10.11.'))">net9.0</TargetFramework>
    <TargetFramework Condition="$([System.String]::Copy('$(JellyfinVersion)').StartsWith('12.'))">net10.0</TargetFramework>
    <DefineConstants Condition="'$(JellyfinVersion)' == '10.10.7'">$(DefineConstants);JELLYFIN_1010</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('$(JellyfinVersion)').StartsWith('12.'))">$(DefineConstants);JELLYFIN_12</DefineConstants>
    <ReleaseVersion Condition="'$(ReleaseVersion)' == ''">1.5</ReleaseVersion>
    <AssemblyVersion>$(ReleaseVersion)</AssemblyVersion>
    <FileVersion>$(ReleaseVersion)</FileVersion>
    <Version>$(ReleaseVersion)</Version>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Jellyfin.Plugin.TvItemLayout</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="verification/**" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <EmbeddedResource Include="../assets/seasonal/*.webp" LogicalName="Jellyfin.Plugin.TvItemLayout.SeasonalAssets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../assets/seasonal-fonts/*.woff2" LogicalName="Jellyfin.Plugin.TvItemLayout.SeasonalFonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../assets/seasonal-fonts/*-OFL.txt" LogicalName="Jellyfin.Plugin.TvItemLayout.SeasonalFonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Configuration/configPage.html" LogicalName="Jellyfin.Plugin.TvItemLayout.Configuration.configPage.html" />
    <EmbeddedResource Include="../dist/jellyfin-tv-layout.js" LogicalName="Jellyfin.Plugin.TvItemLayout.ClientScript.js" />
  </ItemGroup>

  <Target Name="RequireClientScript" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../dist/jellyfin-tv-layout.js')" Text="Build the client first: run npm ci and npm run build from the repository root." />
  </Target>
</Project>
